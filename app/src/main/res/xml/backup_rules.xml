<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde automatique (Android 11 et moins) : la base Room n'est pas sauvegardée. Elle
   référence les médias par _ID MediaStore, propre à l'appareil : restaurée ailleurs, elle
   rattacherait favoris et albums à d'autres photos. L'index est reconstruit depuis MediaStore.
   Le cache de jetons MSAL (OneDrive) est exclu : chiffré par une clé Keystore propre à
   l'appareil, il serait illisible une fois restauré. Il faut simplement se reconnecter.
   La clé de chiffrement MSAL enveloppée par le Keystore (app_<paquet>/adalks, répertoire
   utilisé uniquement par MSAL) est exclue pour la même raison, ainsi que l'état de
   synchronisation OneDrive (cloud_sync.xml), lié à l'index local.
   La configuration MSAL générée vit dans noBackupFilesDir (jamais sauvegardé).
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="root" path="app_fr.eva.cloudgallery/" />
    <exclude domain="sharedpref" path="cloud_sync.xml" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.xml" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.foci.xml" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.uid.xml" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.xml" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.current_account.xml" />
</full-backup-content>
