<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto backup (Android 11 and lower): the Room database is not backed up. It references
   media by MediaStore _ID, which is device-specific: restored elsewhere, it would attach
   favorites and albums to other photos. The index is rebuilt from MediaStore.
   The MSAL token cache (OneDrive) is excluded: encrypted with a device-specific Keystore key,
   it would be unreadable once restored. The user simply has to sign in again.
   The MSAL encryption key wrapped by the Keystore (app_<package>/adalks, a directory used
   only by MSAL) is excluded for the same reason, as is the OneDrive sync state
   (cloud_sync.xml), tied to the local index. Recent searches (search_history.xml) stay on
   the device.
   The generated MSAL configuration lives in noBackupFilesDir (never backed up).
   OneDrive offline copies (files/offline/) are excluded: large, tied to the local index, and
   downloadable again.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="root" path="app_fr.eva.cloudgallery/" />
    <exclude domain="sharedpref" path="cloud_sync.xml" />
    <exclude domain="sharedpref" path="search_history.xml" />
    <exclude domain="file" path="offline/" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.xml" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.foci.xml" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.uid.xml" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.xml" />
    <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.current_account.xml" />
</full-backup-content>
