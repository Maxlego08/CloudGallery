<?xml version="1.0" encoding="utf-8"?>
<!--
   Cloud backup and device transfer: the Room database is excluded (device-specific MediaStore
   IDs, see backup_rules.xml). The MSAL token cache (OneDrive) is excluded too: encrypted with
   a Keystore key, it cannot be restored on another device.
   Same for the MSAL key wrapped by the Keystore (app_<package>/adalks, a directory used only
   by MSAL) and for the OneDrive sync state (cloud_sync.xml).
   Recent searches (search_history.xml) stay on the device.
   OneDrive offline copies (files/offline/) are excluded (downloadable again).
   The other preferences remain backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="root" path="app_fr.eva.cloudgallery/" />
        <exclude domain="sharedpref" path="cloud_sync.xml" />
        <exclude domain="sharedpref" path="search_history.xml" />
        <exclude domain="file" path="offline/" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.foci.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.uid.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.current_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="root" path="app_fr.eva.cloudgallery/" />
        <exclude domain="sharedpref" path="cloud_sync.xml" />
        <exclude domain="sharedpref" path="search_history.xml" />
        <exclude domain="file" path="offline/" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.foci.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.uid.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.current_account.xml" />
    </device-transfer>
</data-extraction-rules>
