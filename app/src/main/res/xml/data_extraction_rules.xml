<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde cloud et transfert d'appareil : la base Room est exclue (identifiants MediaStore
   propres à l'appareil, voir backup_rules.xml). Le cache de jetons MSAL (OneDrive) est exclu
   aussi : chiffré par une clé Keystore, il ne peut pas être restauré sur un autre appareil.
   Même chose pour la clé MSAL enveloppée par le Keystore (app_<paquet>/adalks, répertoire
   utilisé uniquement par MSAL) et pour l'état de synchronisation OneDrive (cloud_sync.xml).
   Les autres préférences restent sauvegardées.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="root" path="app_fr.eva.cloudgallery/" />
        <exclude domain="sharedpref" path="cloud_sync.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.foci.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.uid.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.current_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="root" path="app_fr.eva.cloudgallery/" />
        <exclude domain="sharedpref" path="cloud_sync.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.foci.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.account_credential_cache.uid.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.xml" />
        <exclude domain="sharedpref" path="com.microsoft.identity.client.single_account_credential_cache.current_account.xml" />
    </device-transfer>
</data-extraction-rules>
