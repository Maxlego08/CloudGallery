<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde cloud et transfert d'appareil : la base Room est exclue (identifiants MediaStore
   propres à l'appareil, voir backup_rules.xml). Les préférences restent sauvegardées.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
