<?xml version="1.0" encoding="utf-8"?>
<!--
    Folders exposed by CloudGalleryFileProvider (read-only, share and "Open with").
    Only copies of OneDrive files created by the app, never a user file.
-->
<paths>
    <!-- OneDrive originals downloaded on demand (temporary cache). -->
    <cache-path name="originals" path="onedrive/originals/" />
    <!-- Offline copies (private app files, shared without making a new copy). -->
    <files-path name="offline" path="offline/" />
</paths>
