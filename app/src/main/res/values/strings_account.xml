<!-- OneDrive account screen: sign-in, sign-out, OneDrive data on the device. -->
<resources>
    <string name="account_title">OneDrive account</string>
    <string name="account_section_account">Account</string>
    <string name="account_section_device_data">Data on this device</string>

    <!-- Signed out -->
    <string name="account_intro_title">Connect your OneDrive</string>
    <string name="account_intro_message">Your OneDrive photos and videos will appear in CloudGallery. Access is read-only: your files on OneDrive and on this phone are never modified.</string>
    <string name="account_personal_only">Personal Microsoft accounts only.</string>
    <string name="account_sign_in">Sign in to OneDrive</string>
    <string name="account_signing_in">Signing in…</string>

    <!-- Signed in -->
    <string name="account_signed_in">Signed in</string>
    <string name="account_microsoft_personal">Personal Microsoft account</string>
    <string name="account_read_only">Read-only access</string>
    <string name="account_read_only_summary">Files and profile only. CloudGallery never changes or deletes anything on OneDrive.</string>
    <string name="account_sign_out">Sign out</string>
    <string name="account_sign_out_title">Sign out of OneDrive?</string>
    <string name="account_sign_out_message">OneDrive photos and videos will disappear from CloudGallery, along with their favorites, their album additions, the OneDrive albums (even renamed or pinned ones) and the cached thumbnails. Offline copies are removed from the device. Your files on OneDrive and on this phone are not modified.</string>
    <string name="account_signing_out">Signing out…</string>
    <string name="account_signed_out_toast">Signed out of OneDrive</string>
    <string name="account_sign_out_failed">Can\'t sign out: %1$s</string>

    <!-- Sign in again -->
    <string name="account_reauth_title">Sign-in required</string>
    <string name="account_reauth_message">Your OneDrive session has expired. Sign in again to resume syncing; items already indexed are kept.</string>
    <string name="account_reauth_action">Sign in again</string>

    <!-- Data left over from a previous session -->
    <string name="account_leftover_purge">Remove OneDrive data from this device</string>
    <string name="account_leftover_purge_summary">OneDrive items from a previous session are still in CloudGallery</string>
    <string name="account_purge_title">Remove OneDrive data?</string>
    <string name="account_purge_message">OneDrive photos and videos from a previous session will disappear from CloudGallery, along with their favorites, their album additions and the OneDrive albums. Offline copies are removed from the device. Your files on OneDrive and on this phone are not modified.</string>
    <string name="account_purge_done">OneDrive data removed from this device</string>
    <string name="account_purge_failed">Can\'t remove the OneDrive data.</string>

    <!-- Profile -->
    <string name="account_storage">Microsoft storage</string>
    <string name="account_quota">%1$s used of %2$s</string>

    <!-- Sync -->
    <string name="account_section_sync">Sync</string>
    <string name="account_sync_now">Sync now</string>
    <plurals name="account_sync_running">
        <item quantity="one">Syncing… (%d item received)</item>
        <item quantity="other">Syncing… (%d items received)</item>
    </plurals>
    <string name="account_sync_last">Synced %1$s · %2$s</string>
    <string name="account_sync_never">Not synced yet</string>
    <string name="account_sync_error">Sync failed: %1$s</string>
    <string name="account_sync_paused">Sync paused: different OneDrive account</string>

    <!-- Account other than the one the device data belongs to -->
    <string name="account_mismatch_title">Different OneDrive account</string>
    <string name="account_mismatch_message">The OneDrive items in CloudGallery come from another account. Syncing is paused until you replace them with this account\'s items.</string>
    <string name="account_mismatch_action">Replace with this account</string>
    <string name="account_mismatch_dialog_title">Replace the OneDrive data?</string>
    <string name="account_mismatch_dialog_message">The previous account\'s OneDrive photos and videos will disappear from CloudGallery, along with their favorites, their album additions, the OneDrive albums and the offline copies (removed from the device). This account\'s items will then be synced. Your files on OneDrive and on this phone are not modified.</string>
    <string name="account_mismatch_confirm">Replace</string>
    <string name="account_mismatch_done">Previous account data removed, sync started</string>
    <string name="account_mismatch_failed">Can\'t replace the OneDrive data.</string>

    <!-- Errors and states -->
    <string name="account_error_title">OneDrive unavailable</string>
    <string name="account_not_configured">OneDrive isn\'t configured in this version of the app.</string>
    <string name="account_sign_in_failed">Can\'t sign in: %1$s</string>
    <string name="account_status_signed_out">Not signed in</string>
    <string name="account_status_reauth">Sign-in required</string>
    <string name="account_status_signing_out">Signing out…</string>
