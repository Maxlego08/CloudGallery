<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Médias locaux (Android 13+) : accès complet -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+ : accès partiel « photos sélectionnées » -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Coordonnées GPS non masquées dans les EXIF -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Réseau : OneDrive (phase 3+) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Copies hors ligne (phase 4) : tâche de transfert lancée par l'utilisateur (JobScheduler) -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- Progression des copies hors ligne (demandée au premier « Conserver hors ligne », facultative) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Mise en cache de tout OneDrive : travail WorkManager en service de premier plan (dataSync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".CloudGalleryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.CloudGallery">

        <!-- WorkManager configuré par l'appli (CloudGalleryApp : workers Hilt) : initialiseur par
             défaut retiré, les autres initialiseurs androidx.startup sont gardés. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloudGallery"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_GALLERY" />
            </intent-filter>
            <!-- Permet de choisir CloudGallery pour ouvrir des photos / vidéos depuis d'autres applis -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!--
           Retour de la connexion Microsoft (MSAL) : l'onglet de navigateur redirige vers
           msauth://<applicationId>/<empreinte de signature>. Chemin NON encodé ici (il l'est dans
           la configuration JSON). L'activité est fournie par MSAL ; seul le filtre est ajouté.
        -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="msauth"
                    android:host="${applicationId}"
                    android:path="/${msalSignatureHash}" />
            </intent-filter>
        </activity>

        <!--
           Partage et « Ouvrir avec » des originaux OneDrive téléchargés et des copies hors ligne :
           URI content:// en lecture seule (autorisation accordée par l'intent), dossiers listés
           dans file_paths.xml.
        -->
        <provider
            android:name=".ui.util.CloudGalleryFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
           Téléchargement des copies hors ligne (JobScheduler). Seul le système détient
           BIND_JOB_SERVICE : exporté uniquement pour lui (comme SystemJobService de WorkManager).
        -->
        <service
            android:name=".data.cloud.offline.OfflineTransferJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
           Service de premier plan de WorkManager (mise en cache de tout OneDrive) : type déclaré
           obligatoire depuis Android 14 pour setForeground(ForegroundInfo(…, DATA_SYNC)).
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Bouton « Annuler » de la notification des copies hors ligne (intent explicite). -->
        <receiver
            android:name=".data.cloud.offline.OfflineActionReceiver"
            android:exported="false" />
    </application>

</manifest>
