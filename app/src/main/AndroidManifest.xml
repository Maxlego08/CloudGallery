<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local media (Android 13+): full access -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+: partial "selected photos" access -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Unredacted GPS coordinates in EXIF -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Network: OneDrive (phase 3+) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Offline copies (phase 4): user-initiated transfer job (JobScheduler) -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- Offline copy progress (requested on the first "Keep offline", optional) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Caching of all of OneDrive: WorkManager work as a foreground service (dataSync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- "Move to Secure Folder": offered only if the Samsung app is installed -->
    <queries>
        <package android:name="com.samsung.knox.securefolder" />
        <!-- Browsers: "Open in OneDrive" opens the folder on the web. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".CloudGalleryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.CloudGallery">

        <!-- WorkManager configured by the app (CloudGalleryApp: Hilt workers): default initializer
             removed, the other androidx.startup initializers are kept. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloudGallery"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_GALLERY" />
            </intent-filter>
            <!-- Lets the user pick CloudGallery to open photos / videos from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!--
           Return from the Microsoft sign-in (MSAL): the browser tab redirects to
           msauth://<applicationId>/<signature hash>. Path NOT encoded here (it is in the JSON
           configuration). The activity is provided by MSAL; only the filter is added.
        -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="msauth"
                    android:host="${applicationId}"
                    android:path="/${msalSignatureHash}" />
            </intent-filter>
        </activity>

        <!--
           Share and "Open with" for downloaded OneDrive originals and offline copies: read-only
           content:// URIs (permission granted by the intent), folders listed in
           file_paths.xml.
        -->
        <provider
            android:name=".ui.util.CloudGalleryFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
           Download of offline copies (JobScheduler). Only the system holds BIND_JOB_SERVICE:
           exported for it only (like WorkManager's SystemJobService).
        -->
        <service
            android:name=".data.cloud.offline.OfflineTransferJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
           WorkManager foreground service (caching of all of OneDrive): declared type mandatory
           since Android 14 for setForeground(ForegroundInfo(…, DATA_SYNC)).
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- "Cancel" button of the offline copies notification (explicit intent). -->
        <receiver
            android:name=".data.cloud.offline.OfflineActionReceiver"
            android:exported="false" />
    </application>

</manifest>
